                "ru": "\u042F \u0431\u044B \u0445\u043E\u0442\u0435\u043B \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u0433\u043E\u0440\u043E\u0434"
