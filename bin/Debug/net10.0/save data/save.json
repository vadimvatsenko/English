      {
        "levelName": "A1",
        "themes": [
          {
            "themeName": "A1_01_02_[ A AN  ]",
            "expressions": [
              {
                "en": "It seems to me that it\u0027s a very good idea",
                "ipa": "[\u026At si\u02D0mz tu\u02D0 mi\u02D0 \u00F0\u00E6t \u026Ats \u0259 \u02C8veri \u0261\u028Ad a\u026A\u02C8d\u026A\u0259]",
                "ru": "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u044D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u0438\u0434\u0435\u044F"
              },
              {
                "en": "It\u0027s a very dangerous situation",
                "ipa": "[\u026Ats \u0259 \u02C8veri \u02C8de\u026And\u0292\u0259r\u0259s \u02CCs\u026At\u0283u\u02C8e\u026A\u0283n]",
                "ru": "\u042D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u043E\u043F\u0430\u0441\u043D\u0430\u044F \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F"
              },
              {
                "en": "They are important details",
                "ipa": "[\u00F0e\u026A \u0251\u02D0r \u026Am\u02C8p\u0254\u02D0tnt \u02C8di\u02D0te\u026Alz]",
                "ru": "\u042D\u0442\u043E \u0432\u0430\u0436\u043D\u044B\u0435 \u0434\u0435\u0442\u0430\u043B\u0438"
              },
              {
                "en": "It\u0027s a high mountain",
                "ipa": "[\u026Ats \u0259 ha\u026A \u02C8ma\u028Ant\u0259n]",
                "ru": "\u042D\u0442\u043E \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0433\u043E\u0440\u0430"
              }
            ]
          },
          {
            "themeName": "A1_23_24_[ Past Simple Part_2_Words]",
            "expressions": [
              {
                "en": "an opportunity",
                "ipa": "[\u0259n \u02CC\u0252p\u0259\u02C8tju\u02D0n\u0259ti]",
                "ru": "\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
              }
            ]
          },
          {
            "themeName": "A1_23_24_[ Past Simple Part_3_Practice]",
            "expressions": [
              {
                "en": "I rode a bike yesterday",
                "ipa": "[a\u026A r\u0259\u028Ad \u0259 ba\u026Ak \u02C8jest\u0259de\u026A]",
                "ru": "\u0412\u0447\u0435\u0440\u0430 \u044F \u043A\u0430\u0442\u0430\u043B\u0441\u044F \u043D\u0430 \u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434\u0435"
              },
              {
                "en": "I sat down and then stood up",
                "ipa": "[a\u026A s\u00E6t da\u028An \u00E6nd \u00F0en st\u028Ad \u028Cp]",
                "ru": "\u042F \u0441\u0435\u043B, \u0430 \u0437\u0430\u0442\u0435\u043C \u0432\u0441\u0442\u0430\u043B"
              },
              {
                "en": "I didn\u0027t need it so I threw it away",
                "ipa": "[a\u026A \u02C8d\u026Adnt ni\u02D0d \u026At s\u0259\u028A a\u026A \u03B8ru\u02D0 \u026At \u0259\u02C8we\u026A]",
                "ru": "\u041C\u043D\u0435 \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043D\u0435 \u043D\u0443\u0436\u043D\u043E, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u043B \u044D\u0442\u043E"
              },
              {
                "en": "It hurt her feelings greatly",
                "ipa": "[\u026At h\u025C\u02D0t h\u025C\u02D0 \u02C8fi\u02D0l\u026A\u014Bz \u02C8\u0261re\u026Atli]",
                "ru": "\u042D\u0442\u043E \u0441\u0438\u043B\u044C\u043D\u043E \u0437\u0430\u0434\u0435\u043B\u043E \u0435\u0451 \u0447\u0443\u0432\u0441\u0442\u0432\u0430"
              }
            ]
          },
          {
            "themeName": "A1_21_22_[ Past Simple Part_2_Practice ]",
            "expressions": [
              {
                "en": "They thought that this thing wasn\u0027t so important but it really mattered",
                "ipa": "[\u00F0e\u026A \u03B8\u0254\u02D0t \u00F0\u00E6t \u00F0\u026As \u03B8\u026A\u014B \u02C8w\u0252znt s\u0259\u028A \u026Am\u02C8p\u0254\u02D0tnt b\u028Ct \u026At \u02C8r\u026A\u0259li \u02C8m\u00E6t\u0259d]",
                "ru": "\u041E\u043D\u0438 \u0434\u0443\u043C\u0430\u043B\u0438, \u0447\u0442\u043E \u044D\u0442\u0430 \u0432\u0435\u0449\u044C \u043D\u0435 \u0442\u0430\u043A \u0432\u0430\u0436\u043D\u0430, \u043D\u043E \u043E\u043D\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0438\u043C\u0435\u043B\u0430 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435"
              },
              {
                "en": "The success of this project depended on each of us",
                "ipa": "[\u00F0\u0259 s\u0259k\u02C8ses \u0252v \u00F0\u026As \u02C8pr\u0252d\u0292ekt d\u026A\u02C8pend\u026Ad \u0252n i\u02D0t\u0283 \u0252v \u028Cs]",
                "ru": "\u0423\u0441\u043F\u0435\u0445 \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0437\u0430\u0432\u0438\u0441\u0435\u043B \u043E\u0442 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0438\u0437 \u043D\u0430\u0441"
              }
