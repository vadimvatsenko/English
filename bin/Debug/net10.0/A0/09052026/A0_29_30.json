  "sections": [
    {
      "title": "Past Simple: regular verbs with -ed",
      "rule": "В Past Simple правильные глаголы обычно получают окончание -ed: worked, watched, talked, wanted, played, studied.",
      "examples": [
        { "en": "I worked so much", "ipa": "/aɪ wɜːkt səʊ mʌtʃ/", "ru": "Я работал так много" },
        { "en": "I watched this movie", "ipa": "/aɪ wɒtʃt ðɪs ˈmuːvi/", "ru": "Я посмотрел этот фильм" },
        { "en": "I watched this video", "ipa": "/aɪ wɒtʃt ðɪs ˈvɪdiəʊ/", "ru": "Я посмотрел это видео" },
        { "en": "I watched this program yesterday", "ipa": "/aɪ wɒtʃt ðɪs ˈprəʊɡræm ˈjestədeɪ/", "ru": "Я смотрел эту программу вчера" },
        { "en": "We often talked about it", "ipa": "/wiː ˈɒfən tɔːkt əˈbaʊt ɪt/", "ru": "Мы часто говорили об этом" },
        { "en": "We talked about different things", "ipa": "/wiː tɔːkt əˈbaʊt ˈdɪfrənt θɪŋz/", "ru": "Мы говорили о разных вещах" },
        { "en": "I played different games", "ipa": "/aɪ pleɪd ˈdɪfrənt ɡeɪmz/", "ru": "Я играл в разные игры" },
        { "en": "We played football together", "ipa": "/wiː pleɪd ˈfʊtbɔːl təˈɡeðə/", "ru": "Мы играли в футбол вместе" },
        { "en": "I studied here", "ipa": "/aɪ ˈstʌdid hɪə/", "ru": "Я учился здесь" },
        { "en": "He studied there", "ipa": "/hiː ˈstʌdid ðeə/", "ru": "Он учился там" },
        { "en": "She studied in another country", "ipa": "/ʃiː ˈstʌdid ɪn əˈnʌðə ˈkʌntri/", "ru": "Она училась в другой стране" },
        { "en": "He studied abroad", "ipa": "/hiː ˈstʌdid əˈbrɔːd/", "ru": "Он учился за границей" }
      ]
    },
    {
      "title": "Wanted to + verb",
      "rule": "wanted to + глагол = хотел что-то сделать.",
      "examples": [
        { "en": "I wanted to visit this place", "ipa": "/aɪ ˈwɒntɪd tə ˈvɪzɪt ðɪs pleɪs/", "ru": "Я хотел посетить это место" },
        { "en": "I wanted to improve my English", "ipa": "/aɪ ˈwɒntɪd tə ɪmˈpruːv maɪ ˈɪŋɡlɪʃ/", "ru": "Я хотел улучшить свой английский" },
        { "en": "I wanted to improve my grammar", "ipa": "/aɪ ˈwɒntɪd tə ɪmˈpruːv maɪ ˈɡræmə/", "ru": "Я хотел улучшить свою грамматику" },
        { "en": "I wanted to visit other countries and cities", "ipa": "/aɪ ˈwɒntɪd tə ˈvɪzɪt ˈʌðə ˈkʌntriz ænd ˈsɪtiz/", "ru": "Я хотел посетить другие страны и города" },
        { "en": "I wanted to communicate with people from other countries", "ipa": "/aɪ ˈwɒntɪd tə kəˈmjuːnɪkeɪt wɪð ˈpiːpl frɒm ˈʌðə ˈkʌntriz/", "ru": "Я хотел общаться с людьми из других стран" },
        { "en": "I wanted to choose the best hotel", "ipa": "/aɪ ˈwɒntɪd tə tʃuːz ðə best həʊˈtel/", "ru": "Я хотел выбрать лучший отель" },
        { "en": "I wanted to find a good job", "ipa": "/aɪ ˈwɒntɪd tə faɪnd ə ɡʊd dʒɒb/", "ru": "Я хотел найти хорошую работу" },
        { "en": "He wanted to find a good job", "ipa": "/hiː ˈwɒntɪd tə faɪnd ə ɡʊd dʒɒb/", "ru": "Он хотел найти хорошую работу" }
      ]
    },
    {
      "title": "Looked at / used / needed",
      "rule": "Частые правильные глаголы в Past Simple: looked, used, needed.",
      "examples": [
        { "en": "She looked at him", "ipa": "/ʃiː lʊkt æt hɪm/", "ru": "Она посмотрела на него" },
        { "en": "He looked at her", "ipa": "/hiː lʊkt æt hɜː/", "ru": "Он посмотрел на неё" },
        { "en": "I looked at her and she looked at me", "ipa": "/aɪ lʊkt æt hɜː ænd ʃiː lʊkt æt miː/", "ru": "Я посмотрел на неё, и она посмотрела на меня" },
        { "en": "I often used the Internet", "ipa": "/aɪ ˈɒfən juːzd ði ˈɪntənet/", "ru": "Я часто пользовался интернетом" },
        { "en": "I often used this service", "ipa": "/aɪ ˈɒfən juːzd ðɪs ˈsɜːvɪs/", "ru": "Я часто пользовался этой услугой" },
        { "en": "I needed your help", "ipa": "/aɪ ˈniːdɪd jɔː help/", "ru": "Мне нужна была твоя помощь" },
        { "en": "I needed this money", "ipa": "/aɪ ˈniːdɪd ðɪs ˈmʌni/", "ru": "Мне нужны были эти деньги" }
      ]
    },
    {
      "title": "Asked / answered / liked",
      "rule": "Ещё частые формы Past Simple: asked, answered, liked.",
      "examples": [
        { "en": "I asked him a question", "ipa": "/aɪ ɑːskt hɪm ə ˈkwestʃən/", "ru": "Я задал ему вопрос" },
        { "en": "I asked her some questions", "ipa": "/aɪ ɑːskt hɜː sʌm ˈkwestʃənz/", "ru": "Я задал ей некоторые вопросы" },
        { "en": "He answered this question", "ipa": "/hiː ˈɑːnsəd ðɪs ˈkwestʃən/", "ru": "Он ответил на этот вопрос" },
