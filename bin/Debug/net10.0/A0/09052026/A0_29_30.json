        { "en": "I liked this place", "ipa": "/aɪ laɪkt ðɪs pleɪs/", "ru": "Мне понравилось это место" },
        { "en": "I really liked this video", "ipa": "/aɪ ˈrɪəli laɪkt ðɪs ˈvɪdiəʊ/", "ru": "Мне очень понравилось это видео" },
        { "en": "I really liked this course", "ipa": "/aɪ ˈrɪəli laɪkt ðɪs kɔːs/", "ru": "Мне очень понравился этот курс" }
      ]
    },
    {
      "title": "Happened / ordered / lived",
      "rule": "Фразы из слайдов с happened, ordered, lived.",
      "examples": [
        { "en": "This accident happened yesterday", "ipa": "/ðɪs ˈæksɪdənt ˈhæpənd ˈjestədeɪ/", "ru": "Это происшествие случилось вчера" },
        { "en": "This accident happened last night", "ipa": "/ðɪs ˈæksɪdənt ˈhæpənd lɑːst naɪt/", "ru": "Это происшествие случилось прошлой ночью" },
        { "en": "I ordered my new computer online", "ipa": "/aɪ ˈɔːdəd maɪ njuː kəmˈpjuːtə ˌɒnˈlaɪn/", "ru": "Я заказал свой новый компьютер онлайн" },
        { "en": "I lived in this place", "ipa": "/aɪ lɪvd ɪn ðɪs pleɪs/", "ru": "Я жил в этом месте" },
        { "en": "I lived in this area", "ipa": "/aɪ lɪvd ɪn ðɪs ˈeəriə/", "ru": "Я жил в этом районе" }
      ]
    },
    {
      "title": "Past time markers",
      "rule": "В Past Simple часто используем указатели времени: yesterday, last week, ago, the day before yesterday.",
      "examples": [
        { "en": "I called her yesterday", "ipa": "/aɪ kɔːld hɜː ˈjestədeɪ/", "ru": "Я звонил ей вчера" },
        { "en": "She called me two hours ago", "ipa": "/ʃiː kɔːld miː tuː ˈaʊəz əˈɡəʊ/", "ru": "Она звонила мне два часа назад" },
        { "en": "They arrived an hour ago", "ipa": "/ðeɪ əˈraɪvd ən ˈaʊə əˈɡəʊ/", "ru": "Они прибыли час назад" },
        { "en": "It happened three hours ago", "ipa": "/ɪt ˈhæpənd θriː ˈaʊəz əˈɡəʊ/", "ru": "Это случилось три часа назад" },
        { "en": "He visited us the day before yesterday", "ipa": "/hiː ˈvɪzɪtɪd ʌs ðə deɪ bɪˈfɔː ˈjestədeɪ/", "ru": "Он навестил нас позавчера" },
        { "en": "I started this course", "ipa": "/aɪ ˈstɑːtɪd ðɪs kɔːs/", "ru": "Я начал этот курс" },
        { "en": "I started this course last week", "ipa": "/aɪ ˈstɑːtɪd ðɪs kɔːs lɑːst wiːk/", "ru": "Я начал этот курс на прошлой неделе" },
        { "en": "I finished my work", "ipa": "/aɪ ˈfɪnɪʃt maɪ wɜːk/", "ru": "Я закончил свою работу" },
        { "en": "I finished my work thirty minutes ago", "ipa": "/aɪ ˈfɪnɪʃt maɪ wɜːk ˈθɜːti ˈmɪnɪts əˈɡəʊ/", "ru": "Я закончил свою работу тридцать минут назад" }
      ]
    },
    {
      "title": "Helped me",
      "rule": "helped = помог. Можно усилить really / so much.",
      "examples": [
        { "en": "You really helped me", "ipa": "/juː ˈrɪəli helpt miː/", "ru": "Ты действительно помог мне" },
        { "en": "You helped me so much", "ipa": "/juː helpt miː səʊ mʌtʃ/", "ru": "Ты помог мне так сильно" }
      ]
