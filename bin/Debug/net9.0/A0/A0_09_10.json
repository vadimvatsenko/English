{
  "sections": [
    {
      "title": "Do / Does questions (Present Simple)",
      "rule": "Do + I/you/we/they + verb…?  |  Does + he/she/it + verb…? (после does — глагол без -s).",
      "examples": [
        {
          "en": "Do you want to rent a house?",
          "ipa": "/duː juː wɒnt tə rent ə haʊs?/",
          "ru": "Ты хочешь снять дом?"
        },
        {
          "en": "Do you want to rent an apartment?",
