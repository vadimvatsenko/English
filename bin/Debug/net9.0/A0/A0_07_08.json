          "ru": "Она не говорит по-английски"
        },
        {
          "en": "He doesn't say it",
          "ipa": "/hiː ˈdʌznt seɪ ɪt/",
          "ru": "Он не говорит это"
        },
        {
          "en": "She doesn't say this thing",
          "ipa": "/ʃiː ˈdʌznt seɪ ðɪs θɪŋ/",
          "ru": "Она не говорит эту вещь"
        },
        {
          "en": "She doesn't tell me about it",
          "ipa": "/ʃiː ˈdʌznt tel miː əˈbaʊt ɪt/",
          "ru": "Она не говорит мне об этом"
        },
        {
          "en": "He doesn't tell me this thing",
          "ipa": "/hiː ˈdʌznt tel miː ðɪs θɪŋ/",
          "ru": "Он не говорит мне эту вещь"
        },
        {
          "en": "He doesn't feel happy",
          "ipa": "/hiː ˈdʌznt fiːl ˈhæpi/",
          "ru": "Он не чувствует себя счастливым"
        }
      ]
    },
    {
      "title": "I know / I think that…",
      "rule": "I know / I think that + предложение = «я знаю / думаю, что…».",
      "examples": [
        {
          "en": "I know that it doesn't cost this money",
          "ipa": "/aɪ nəʊ ðæt ɪt ˈdʌzənt kɒst ðɪs ˈmʌni/",
          "ru": "Я знаю, что это не стоит этих денег"
        }
      ]
    }
  ]
